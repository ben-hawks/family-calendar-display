# presence-display settings. Installed to ~/.config/presence-display/presence-display.env
# Restart after editing:  systemctl --user restart presence-display

# BCM GPIO number wired to the LD2410C OUT pin (GPIO17 = physical pin 11)
PRESENCE_GPIO=17

# Seconds with no presence before the screen turns off. This stacks on top of the
# LD2410C's own "unmanned duration" set in the HLKRadarTool app.
OFF_DELAY=30

# Commands that switch the HDMI output (labwc / wlroots). '*' means all outputs.
DISPLAY_ON_CMD=wlopm --on *
DISPLAY_OFF_CMD=wlopm --off *

# Set to true to log what would happen without touching the display
DRY_RUN=false

# --- Optional MQTT / Home Assistant discovery (leave MQTT_HOST empty to disable) ---
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
# Defaults to presence_display_<hostname> / "<hostname> calendar display"
MQTT_NODE_ID=
MQTT_DEVICE_NAME=

LOG_LEVEL=INFO
